# Copy to .env.local. Voice still works without a key: the local parser is the fallback.

# Meta Model API (Muse / Llama). Required only for the LLM voice router.
META_API_KEY=

# Optional overrides. Defaults target Meta's hosted Model API.
# META_API_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3
# META_TIMEOUT_MS=4000
